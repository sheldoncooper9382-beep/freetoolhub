body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #2b004d, #000000);
  color: #eee;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  min-height: 100vh;
  padding-top: 40px;
}

.container {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(12px);
  padding: 24px;
  border-radius: 16px;
  width: 360px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.6);
}

h1 {
  text-align: center;
  margin-bottom: 20px;
}

.preview {
  height: 120px;
  background: #1e1e1e;
  border-radius: 12px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20px;
  color: #fff;
  font-weight: bold;
  transition: box-shadow 0.2s ease;
}

.controls label {
  display: block;
  margin-top: 10px;
}

.controls input[type="range"],
.controls input[type="number"],
.controls input[type="color"] {
  width: 100%;
  margin: 6px 0;
  border-radius: 6px;
  border: none;
  padding: 6px;
}

.controls input[type="number"] {
  margin-top: 0;
}

.controls button {
  width: 48%;
  margin: 6px 1%;
  padding: 10px;
  border-radius: 8px;
  border: none;
  background: rgba(255,255,255,0.1);
  color: #fff;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.15s;
}

.controls button:hover {
  transform: scale(1.05);
  box-shadow: 0 0 12px rgba(255,255,255,0.4);
}

textarea {
  width: 100%;
  height: 80px;
  margin-top: 12px;
  border-radius: 8px;
  border: none;
  padding: 10px;
  background: rgba(0,0,0,0.3);
  color: #fff;
  resize: none;
}
