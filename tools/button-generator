

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Button Generator</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            color: #fff;
        }

        .container {
            display: flex;
            max-width: 1400px;
            width: 100%;
            gap: 30px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .preview-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 15px;
            padding: 40px;
            min-height: 500px;
        }

        .preview-container {
            width: 100%;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 30px;
        }

        #preview-button {
            cursor: pointer;
            border: none;
            outline: none;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .controls-panel {
            flex: 1;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 25px;
            overflow-y: auto;
            max-height: 750px;
        }

        .control-group {
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        h2 {
            font-size: 1.4rem;
            margin-bottom: 15px;
            color: #4cc9f0;
        }

        .control-row {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 10px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.9rem;
            color: #ccc;
        }

        input[type="text"], input[type="range"], input[type="color"], select {
            width: 100%;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(0, 0, 0, 0.3);
            color: white;
            font-size: 0.9rem;
        }

        input[type="range"] {
            padding: 0;
        }

        .checkbox-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .checkbox-row input[type="checkbox"] {
            width: auto;
        }

        .code-panel {
            flex: 1;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 15px;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .code-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .code-output {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
            padding: 15px;
            font-family: monospace;
            font-size: 0.9rem;
            color: #f8f8f2;
            white-space: pre-wrap;
            overflow: auto;
            flex-grow: 1;
            max-height: 200px;
        }

        button {
            background: #4361ee;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.3s;
        }

        button:hover {
            background: #3a56d4;
        }

        .copy-btn {
            background: #7209b7;
        }

        .copy-btn:hover {
            background: #5e0a96;
        }

        .preset-btn {
            background: #2a9d8f;
            padding: 5px 10px;
            font-size: 0.8rem;
        }

        .preset-btn:hover {
            background: #21867a;
        }

        .presets {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .gradient-colors {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .color-input {
            flex: 1;
            min-width: 80px;
        }
        
        .glass-colors {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .glass-color-input {
            flex: 1;
            min-width: 80px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="preview-panel">
            <h1>Button Preview</h1>
            <div class="preview-container">
                <button id="preview-button">Sample Button</button>
            </div>
            <p>Live preview of your button design</p>
        </div>

        <div class="controls-panel">
            <div class="control-group">
                <h2>Text & Size</h2>
                <div class="control-row">
                    <div>
                        <label for="button-text">Button Text</label>
                        <input type="text" id="button-text" value="Click Me">
                    </div>
                </div>
                <div class="control-row">
                    <div>
                        <label for="width">Width: <span id="width-value">150px</span></label>
                        <input type="range" id="width" min="50" max="300" value="150">
                    </div>
                    <div>
                        <label for="height">Height: <span id="height-value">50px</span></label>
                        <input type="range" id="height" min="20" max="150" value="50">
                    </div>
                </div>
                <div class="control-row">
                    <div>
                        <label for="font-size">Font Size: <span id="font-size-value">16px</span></label>
                        <input type="range" id="font-size" min="10" max="40" value="16">
                    </div>
                </div>
            </div>

            <div class="control-group">
                <h2>Shape & Border</h2>
                <div class="control-row">
                    <div>
                        <label for="shape">Shape</label>
                        <select id="shape">
                            <option value="square">Square</option>
                            <option value="rounded">Rounded</option>
                            <option value="pill">Pill</option>
                            <option value="custom">Custom Radius</option>
                        </select>
                    </div>
                    <div id="border-radius-control" style="display:none;">
                        <label for="border-radius">Border Radius: <span id="border-radius-value">10px</span></label>
                        <input type="range" id="border-radius" min="0" max="100" value="10">
                    </div>
                </div>
            </div>

            <div class="control-group">
                <h2>Colors & Gradient</h2>
                <div class="control-row">
                    <div>
                        <label for="bg-color">Background Color</label>
                        <input type="color" id="bg-color" value="#4361ee">
                    </div>
                    <div>
                        <label for="text-color">Text Color</label>
                        <input type="color" id="text-color" value="#ffffff">
                    </div>
                </div>
                <div class="control-row">
                    <div class="checkbox-row">
                        <input type="checkbox" id="gradient-enabled">
                        <label for="gradient-enabled">Enable Gradient</label>
                    </div>
                </div>
                <div id="gradient-controls" style="display:none;">
                    <div class="gradient-colors">
                        <div class="color-input">
                            <label>Color 1</label>
                            <input type="color" class="gradient-color" value="#4361ee">
                        </div>
                        <div class="color-input">
                            <label>Color 2</label>
                            <input type="color" class="gradient-color" value="#3a0ca3">
                        </div>
                        <div class="color-input">
                            <label>Color 3</label>
                            <input type="color" class="gradient-color" value="#4cc9f0">
                        </div>
                        <div class="color-input">
                            <label>Color 4</label>
                            <input type="color" class="gradient-color" value="#f72585">
                        </div>
                    </div>
                    <div class="control-row">
                        <div>
                            <label for="gradient-direction">Direction</label>
                            <select id="gradient-direction">
                                <option value="to right">Left to Right</option>
                                <option value="to left">Right to Left</option>
                                <option value="to bottom">Top to Bottom</option>
                                <option value="to top">Bottom to Top</option>
                                <option value="to bottom right">Diagonal</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="control-group">
                <h2>Effects</h2>
                <div class="control-row">
                    <div class="checkbox-row">
                        <input type="checkbox" id="neon-enabled">
                        <label for="neon-enabled">Neon/Glow Effect</label>
                    </div>
                    <div id="neon-controls" style="display:none;">
                        <label for="neon-color">Glow Color</label>
                        <input type="color" id="neon-color" value="#4cc9f0">
                        <label for="neon-intensity">Intensity: <span id="neon-intensity-value">10px</span></label>
                        <input type="range" id="neon-intensity" min="1" max="30" value="10">
                    </div>
                </div>
                <div class="control-row">
                    <div class="checkbox-row">
                        <input type="checkbox" id="glass-enabled">
                        <label for="glass-enabled">Frosted Glass Effect</label>
                    </div>
                </div>
                <div id="glass-controls" style="display:none;">
                    <div class="glass-colors">
                        <div class="glass-color-input">
                            <label>Base Color</label>
                            <input type="color" id="glass-color" value="#ffffff">
                        </div>
                        <div class="glass-color-input">
                            <label>Highlight</label>
                            <input type="color" id="glass-highlight" value="#ffffff">
                        </div>
                    </div>
                    <div class="control-row">
                        <div>
                            <label for="glass-opacity">Opacity: <span id="glass-opacity-value">20%</span></label>
                            <input type="range" id="glass-opacity" min="1" max="50" value="20">
                        </div>
                        <div>
                            <label for="glass-blur">Blur: <span id="glass-blur-value">10px</span></label>
                            <input type="range" id="glass-blur" min="1" max="30" value="10">
                        </div>
                    </div>
                </div>
                <div class="control-row">
                    <div class="checkbox-row">
                        <input type="checkbox" id="jelly-enabled">
                        <label for="jelly-enabled">Jelly Roll Effect</label>
                    </div>
                </div>
                <div class="control-row">
                    <div class="checkbox-row">
                        <input type="checkbox" id="transition-enabled">
                        <label for="transition-enabled">Smooth Transitions</label>
                    </div>
                </div>
            </div>

            <div class="control-group">
                <h2>Shadow</h2>
                <div class="control-row">
                    <div>
                        <label for="shadow-x">X Position: <span id="shadow-x-value">0px</span></label>
                        <input type="range" id="shadow-x" min="-20" max="20" value="0">
                    </div>
                    <div>
                        <label for="shadow-y">Y Position: <span id="shadow-y-value">5px</span></label>
                        <input type="range" id="shadow-y" min="-20" max="20" value="5">
                    </div>
                </div>
                <div class="control-row">
                    <div>
                        <label for="shadow-blur">Blur: <span id="shadow-blur-value">10px</span></label>
                        <input type="range" id="shadow-blur" min="0" max="30" value="10">
                    </div>
                    <div>
                        <label for="shadow-color">Color</label>
                        <input type="color" id="shadow-color" value="#000000">
                    </div>
                </div>
            </div>

            <div class="control-group">
                <h2>Preset Styles</h2>
                <div class="presets">
                    <button class="preset-btn" data-preset="neon">Neon</button>
                    <button class="preset-btn" data-preset="glass">Glass</button>
                    <button class="preset-btn" data-preset="gradient">Gradient</button>
                    <button class="preset-btn" data-preset="jelly">Jelly</button>
                    <button class="preset-btn" data-preset="default">Default</button>
                </div>
            </div>
        </div>

        <div class="code-panel">
            <div class="code-header">
                <h2>Generated CSS</h2>
                <button class="copy-btn" id="copy-css">Copy CSS</button>
            </div>
            <div class="code-output" id="css-output">
                /* Your CSS will appear here */
            </div>
            <div class="code-header" style="margin-top: 20px;">
                <h2>HTML</h2>
                <button class="copy-btn" id="copy-html">Copy HTML</button>
            </div>
            <div class="code-output" id="html-output">
                /* Your HTML will appear here */
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get all elements
            const previewButton = document.getElementById('preview-button');
            const buttonText = document.getElementById('button-text');
            const widthSlider = document.getElementById('width');
            const heightSlider = document.getElementById('height');
            const fontSizeSlider = document.getElementById('font-size');
            const widthValue = document.getElementById('width-value');
            const heightValue = document.getElementById('height-value');
            const fontSizeValue = document.getElementById('font-size-value');
            const shapeSelect = document.getElementById('shape');
            const borderRadiusSlider = document.getElementById('border-radius');
            const borderRadiusValue = document.getElementById('border-radius-value');
            const borderRadiusControl = document.getElementById('border-radius-control');
            const bgColor = document.getElementById('bg-color');
            const textColor = document.getElementById('text-color');
            const gradientEnabled = document.getElementById('gradient-enabled');
            const gradientControls = document.getElementById('gradient-controls');
            const gradientColors = document.querySelectorAll('.gradient-color');
            const gradientDirection = document.getElementById('gradient-direction');
            const neonEnabled = document.getElementById('neon-enabled');
            const neonControls = document.getElementById('neon-controls');
            const neonColor = document.getElementById('neon-color');
            const neonIntensity = document.getElementById('neon-intensity');
            const neonIntensityValue = document.getElementById('neon-intensity-value');
            const glassEnabled = document.getElementById('glass-enabled');
            const glassControls = document.getElementById('glass-controls');
            const glassColor = document.getElementById('glass-color');
            const glassHighlight = document.getElementById('glass-highlight');
            const glassOpacity = document.getElementById('glass-opacity');
            const glassBlur = document.getElementById('glass-blur');
            const glassOpacityValue = document.getElementById('glass-opacity-value');
            const glassBlurValue = document.getElementById('glass-blur-value');
            const jellyEnabled = document.getElementById('jelly-enabled');
            const transitionEnabled = document.getElementById('transition-enabled');
            const shadowX = document.getElementById('shadow-x');
            const shadowY = document.getElementById('shadow-y');
            const shadowBlur = document.getElementById('shadow-blur');
            const shadowColor = document.getElementById('shadow-color');
            const shadowXValue = document.getElementById('shadow-x-value');
            const shadowYValue = document.getElementById('shadow-y-value');
            const shadowBlurValue = document.getElementById('shadow-blur-value');
            const cssOutput = document.getElementById('css-output');
            const htmlOutput = document.getElementById('html-output');
            const copyCssBtn = document.getElementById('copy-css');
            const copyHtmlBtn = document.getElementById('copy-html');
            const presetBtns = document.querySelectorAll('.preset-btn');

            // Initialize button styles
            updateButtonStyles();

            // Event listeners for all controls
            buttonText.addEventListener('input', updateButtonStyles);
            widthSlider.addEventListener('input', function() {
                widthValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            heightSlider.addEventListener('input', function() {
                heightValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            fontSizeSlider.addEventListener('input', function() {
                fontSizeValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            shapeSelect.addEventListener('change', function() {
                if(this.value === 'custom') {
                    borderRadiusControl.style.display = 'block';
                } else {
                    borderRadiusControl.style.display = 'none';
                }
                updateButtonStyles();
            });
            borderRadiusSlider.addEventListener('input', function() {
                borderRadiusValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            bgColor.addEventListener('input', updateButtonStyles);
            textColor.addEventListener('input', updateButtonStyles);
            gradientEnabled.addEventListener('change', function() {
                gradientControls.style.display = this.checked ? 'block' : 'none';
                updateButtonStyles();
            });
            gradientColors.forEach(color => {
                color.addEventListener('input', updateButtonStyles);
            });
            gradientDirection.addEventListener('change', updateButtonStyles);
            neonEnabled.addEventListener('change', function() {
                neonControls.style.display = this.checked ? 'block' : 'none';
                updateButtonStyles();
            });
            neonColor.addEventListener('input', updateButtonStyles);
            neonIntensity.addEventListener('input', function() {
                neonIntensityValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            glassEnabled.addEventListener('change', function() {
                glassControls.style.display = this.checked ? 'block' : 'none';
                updateButtonStyles();
            });
            glassColor.addEventListener('input', updateButtonStyles);
            glassHighlight.addEventListener('input', updateButtonStyles);
            glassOpacity.addEventListener('input', function() {
                glassOpacityValue.textContent = this.value + '%';
                updateButtonStyles();
            });
            glassBlur.addEventListener('input', function() {
                glassBlurValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            jellyEnabled.addEventListener('change', updateButtonStyles);
            transitionEnabled.addEventListener('change', updateButtonStyles);
            shadowX.addEventListener('input', function() {
                shadowXValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            shadowY.addEventListener('input', function() {
                shadowYValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            shadowBlur.addEventListener('input', function() {
                shadowBlurValue.textContent = this.value + 'px';
                updateButtonStyles();
            });
            shadowColor.addEventListener('input', updateButtonStyles);

            // Preset buttons
            presetBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const preset = this.getAttribute('data-preset');
                    applyPreset(preset);
                });
            });

            // Copy to clipboard
            copyCssBtn.addEventListener('click', function() {
                const cssCode = cssOutput.textContent;
                navigator.clipboard.writeText(cssCode).then(() => {
                    alert('CSS copied to clipboard!');
                });
            });

            copyHtmlBtn.addEventListener('click', function() {
                const htmlCode = htmlOutput.textContent;
                navigator.clipboard.writeText(htmlCode).then(() => {
                    alert('HTML copied to clipboard!');
                });
            });

            // Function to update button styles
            function updateButtonStyles() {
                // Reset styles
                previewButton.style.cssText = '';

                // Apply basic styles
                previewButton.textContent = buttonText.value;
                previewButton.style.width = widthSlider.value + 'px';
                previewButton.style.height = heightSlider.value + 'px';
                previewButton.style.fontSize = fontSizeSlider.value + 'px';
                previewButton.style.color = textColor.value;

                // Apply shape
                if(shapeSelect.value === 'square') {
                    previewButton.style.borderRadius = '0px';
                } else if(shapeSelect.value === 'rounded') {
                    previewButton.style.borderRadius = '8px';
                } else if(shapeSelect.value === 'pill') {
                    previewButton.style.borderRadius = '50px';
                } else {
                    previewButton.style.borderRadius = borderRadiusSlider.value + 'px';
                }

                // Apply background
                if(gradientEnabled.checked) {
                    const colors = Array.from(gradientColors).map(c => c.value);
                    const validColors = colors.filter(c => c !== '');
                    if(validColors.length > 1) {
                        previewButton.style.background = `linear-gradient(${gradientDirection.value}, ${validColors.join(', ')})`;
                    } else {
                        previewButton.style.background = bgColor.value;
                    }
                } else {
                    previewButton.style.background = bgColor.value;
                }

                // Apply effects
                let boxShadow = `${shadowX.value}px ${shadowY.value}px ${shadowBlur.value}px ${shadowColor.value}`;
                
                if(neonEnabled.checked) {
                    const intensity = neonIntensity.value;
                    const glow = `0 0 ${intensity}px ${neonColor.value}, 0 0 ${intensity * 2}px ${neonColor.value}`;
                    boxShadow = `${boxShadow}, ${glow}`;
                }

                if(glassEnabled.checked) {
                    const opacity = glassOpacity.value / 100;
                    const blur = glassBlur.value;
                    previewButton.style.background = `radial-gradient(circle at 20% 50%, ${glassHighlight.value}00, ${glassHighlight.value}00), radial-gradient(circle at 80% 50%, ${glassColor.value}00, ${glassColor.value}00), rgba(255, 255, 255, ${opacity})`;
                    previewButton.style.backdropFilter = `blur(${blur}px)`;
                    previewButton.style.border = `1px solid rgba(255, 255, 255, 0.2)`;
                    previewButton.style.color = '#ffffff';
                    previewButton.style.boxShadow = boxShadow;
                } else {
                    previewButton.style.boxShadow = boxShadow;
                }

                if(jellyEnabled.checked) {
                    previewButton.style.transition = 'all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55)';
                    previewButton.addEventListener('mouseenter', handleJellyHover);
                    previewButton.addEventListener('mouseleave', handleJellyLeave);
                } else {
                    previewButton.removeEventListener('mouseenter', handleJellyHover);
                    previewButton.removeEventListener('mouseleave', handleJellyLeave);
                }

                if(transitionEnabled.checked) {
                    previewButton.style.transition = 'all 0.3s ease';
                }

                // Update code output
                updateCodeOutput();
            }

            // Jelly effect handlers
            function handleJellyHover() {
                this.style.transform = 'scale(1.05)';
            }

            function handleJellyLeave() {
                this.style.transform = 'scale(1)';
            }

            // Function to update code output
            function updateCodeOutput() {
                const text = buttonText.value;
                const width = widthSlider.value + 'px';
                const height = heightSlider.value + 'px';
                const fontSize = fontSizeSlider.value + 'px';
                const color = textColor.value;
                
                let background = bgColor.value;
                if(gradientEnabled.checked) {
                    const colors = Array.from(gradientColors).map(c => c.value).filter(c => c !== '');
                    if(colors.length > 1) {
                        background = `linear-gradient(${gradientDirection.value}, ${colors.join(', ')})`;
                    }
                }
                
                const borderRadius = shapeSelect.value === 'custom' 
                    ? borderRadiusSlider.value + 'px' 
                    : shapeSelect.value === 'square' ? '0px' : shapeSelect.value === 'rounded' ? '8px' : '50px';
                
                let boxShadow = `${shadowX.value}px ${shadowY.value}px ${shadowBlur.value}px ${shadowColor.value}`;
                
                if(neonEnabled.checked) {
                    const intensity = neonIntensity.value;
                    const glow = `0 0 ${intensity}px ${neonColor.value}, 0 0 ${intensity * 2}px ${neonColor.value}`;
                    boxShadow = `${boxShadow}, ${glow}`;
                }
                
                const glassStyle = glassEnabled.checked 
                    ? `background: radial-gradient(circle at 20% 50%, ${glassHighlight.value}00, ${glassHighlight.value}00), radial-gradient(circle at 80% 50%, ${glassColor.value}00, ${glassColor.value}00), rgba(255, 255, 255, ${glassOpacity.value / 100}); backdrop-filter: blur(${glassBlur.value}px); border: 1px solid rgba(255, 255, 255, 0.2); color: #ffffff;`
                    : '';
                
                const transitionStyle = transitionEnabled.checked ? 'transition: all 0.3s ease;' : '';
                
                const jellyStyle = jellyEnabled.checked 
                    ? 'transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55); &:hover { transform: scale(1.05); }'
                    : '';
                
                const cssCode = `.custom-button {
    width: ${width};
    height: ${height};
    font-size: ${fontSize};
    color: ${color};
    background: ${background};
    border-radius: ${borderRadius};
    border: none;
    outline: none;
    cursor: pointer;
    box-shadow: ${boxShadow};
    ${glassStyle}
    ${transitionStyle}
    ${jellyStyle ? jellyStyle : ''}
}`;
                
                const htmlCode = `<button class="custom-button">${text}</button>`;
                
                cssOutput.textContent = cssCode;
                htmlOutput.textContent = htmlCode;
            }

            // Function to apply presets
            function applyPreset(preset) {
                switch(preset) {
                    case 'neon':
                        gradientEnabled.checked = false;
                        neonEnabled.checked = true;
                        glassEnabled.checked = false;
                        jellyEnabled.checked = false;
                        transitionEnabled.checked = true;
                        bgColor.value = '#000000';
                        textColor.value = '#00ffea';
                        neonColor.value = '#00ffea';
                        neonIntensity.value = 15;
                        shadowX.value = 0;
                        shadowY.value = 0;
                        shadowBlur.value = 15;
                        shadowXValue.textContent = '0px';
                        shadowYValue.textContent = '0px';
                        shadowBlurValue.textContent = '15px';
                        neonIntensityValue.textContent = '15px';
                        break;
                    case 'glass':
                        gradientEnabled.checked = false;
                        neonEnabled.checked = false;
                        glassEnabled.checked = true;
                        jellyEnabled.checked = false;
                        transitionEnabled.checked = true;
                        glassColor.value = '#ffffff';
                        glassHighlight.value = '#ffffff';
                        glassOpacity.value = 20;
                        glassBlur.value = 10;
                        textColor.value = '#ffffff';
                        shadowX.value = 0;
                        shadowY.value = 8;
                        shadowBlur.value = 32;
                        shadowColor.value = '#000000';
                        shadowXValue.textContent = '0px';
                        shadowYValue.textContent = '8px';
                        shadowBlurValue.textContent = '32px';
                        glassOpacityValue.textContent = '20%';
                        glassBlurValue.textContent = '10px';
                        break;
                    case 'gradient':
                        gradientEnabled.checked = true;
                        neonEnabled.checked = false;
                        glassEnabled.checked = false;
                        jellyEnabled.checked = false;
                        transitionEnabled.checked = true;
                        gradientColors[0].value = '#ff6b6b';
                        gradientColors[1].value = '#4ecdc4';
                        gradientColors[2].value = '#45b7d1';
                        gradientColors[3].value = '#96ceb4';
                        textColor.value = '#ffffff';
                        shadowX.value = 0;
                        shadowY.value = 4;
                        shadowBlur.value = 10;
                        shadowColor.value = '#000000';
                        shadowXValue.textContent = '0px';
                        shadowYValue.textContent = '4px';
                        shadowBlurValue.textContent = '10px';
                        break;
                    case 'jelly':
                        gradientEnabled.checked = true;
                        neonEnabled.checked = false;
                        glassEnabled.checked = false;
                        jellyEnabled.checked = true;
                        transitionEnabled.checked = true;
                        gradientColors[0].value = '#a8edea';
                        gradientColors[1].value = '#fed6e3';
                        gradientColors[2].value = '#f5b7b1';
                        gradientColors[3].value = '#d5d8dc';
                        textColor.value = '#333333';
                        shadowX.value = 0;
                        shadowY.value = 4;
                        shadowBlur.value = 10;
                        shadowColor.value = '#000000';
                        shadowXValue.textContent = '0px';
                        shadowYValue.textContent = '4px';
                        shadowBlurValue.textContent = '10px';
                        break;
                    case 'default':
                        gradientEnabled.checked = false;
                        neonEnabled.checked = false;
                        glassEnabled.checked = false;
                        jellyEnabled.checked = false;
                        transitionEnabled.checked = true;
                        bgColor.value = '#4361ee';
                        textColor.value = '#ffffff';
                        shadowX.value = 0;
                        shadowY.value = 5;
                        shadowBlur.value = 10;
                        shadowColor.value = '#000000';
                        shadowXValue.textContent = '0px';
                        shadowYValue.textContent = '5px';
                        shadowBlurValue.textContent = '10px';
                        break;
                }
                
                // Update the UI to reflect changes
                gradientControls.style.display = gradientEnabled.checked ? 'block' : 'none';
                neonControls.style.display = neonEnabled.checked ? 'block' : 'none';
                glassControls.style.display = glassEnabled.checked ? 'block' : 'none';
                borderRadiusControl.style.display = shapeSelect.value === 'custom' ? 'block' : 'none';
                
                updateButtonStyles();
            }
        });
    </script>
</body>
</html>
